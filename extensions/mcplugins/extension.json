{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "mcplugins",
    "name": "MC Plugins",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Browse and install Minecraft plugins from the panel",
    "author": "YumeeKunn",
    "provider": "Mcplugins\\McpluginsProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "mp",
        "screens": [
            {
                "id": "main",
                "area": "server",
                "path": "mcplugins",
                "nav": {
                    "label": "MC Plugins"
                }
            }
        ]
    },
    "autoload": {
        "Mcplugins\\": "src/"
    }
}
{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "startupchanger",
    "name": "Startup Changer",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Let users edit their server startup command safely with pattern validation",
    "author": "YumeeKunn",
    "provider": "Startupchanger\\StartupchangerProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "stc",
        "screens": [
            {
                "id": "main",
                "area": "server",
                "path": "startupchanger",
                "nav": {
                    "label": "Startup Changer"
                }
            }
        ]
    },
    "autoload": {
        "Startupchanger\\": "src/"
    }
}
{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "subdomains",
    "name": "SubDomains",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Custom subdomains for game servers via Cloudflare",
    "author": "YumeeKunn",
    "provider": "Subdomains\\SubdomainsProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "sd",
        "screens": [
            {
                "id": "main",
                "area": "server",
                "path": "subdomains",
                "nav": {
                    "label": "SubDomains"
                }
            }
        ]
    },
    "autoload": {
        "Subdomains\\": "src/"
    }
}
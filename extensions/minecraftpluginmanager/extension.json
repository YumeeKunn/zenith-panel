{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "minecraftpluginmanager",
    "name": "Plugin Manager",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Install and manage Minecraft plugins with search and filtering",
    "author": "YumeeKunn",
    "provider": "Minecraftpluginmanager\\MinecraftpluginmanagerProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "pm",
        "screens": [
            {
                "id": "main",
                "area": "server",
                "path": "minecraftpluginmanager",
                "nav": {
                    "label": "Plugin Manager"
                }
            }
        ]
    },
    "autoload": {
        "Minecraftpluginmanager\\": "src/"
    }
}